ots 1
# journey-setup.2: second run of journey-setup on the same user directory: the changed
# settings are shown, then quit.
# Authored against ot-ref-run (virtual clock); the title menu is ready at ~8.1 s.
# title: Setup
@8500 key-down DOWN
@8560 key-up DOWN
@8800 key-down DOWN
@8860 key-up DOWN
@9100 key-down DOWN
@9160 key-up DOWN
@9400 key-down DOWN
@9460 key-up DOWN
@9700 key-down RETURN
@9760 key-up RETURN
# Setup: Graphics... shows the settings of the first run
@11200 key-down RETURN
@11260 key-up RETURN
# Graphics: Done
@13000 key-down UP
@13060 key-up UP
@13300 key-down RETURN
@13360 key-up RETURN
# Setup: Sound... shows the volumes of the first run
@14400 key-down DOWN
@14460 key-up DOWN
@14700 key-down RETURN
@14760 key-up RETURN
# Sound: Done
@16500 key-down UP
@16560 key-up UP
@16800 key-down RETURN
@16860 key-up RETURN
# Setup: Done
@17900 key-down DOWN
@17960 key-up DOWN
@18200 key-down DOWN
@18260 key-up DOWN
@18500 key-down RETURN
@18560 key-up RETURN
# title: Quit
@20300 key-down DOWN
@20360 key-up DOWN
@20600 key-down DOWN
@20660 key-up DOWN
@20900 key-down RETURN
@20960 key-up RETURN
